# Local development: npm run dev needs no cloud credentials.
# These settings are for a later live/cloud deployment.
ANALYSIS_MODE=live
GOOGLE_CLOUD_PROJECT=your-project-id
# Optional separate inference project for local live or split-project deployment:
# GEMINI_PROJECT_ID=your-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=choose-a-current-audio-capable-model
STORAGE_BUCKET=your-private-bucket
# Optional dedicated named database in a shared project; defaults to (default).
FIRESTORE_DATABASE_ID=emergency-copilot
ALLOWED_ORIGIN=https://app.example.invalid
VITE_FIREBASE_API_KEY=your-firebase-web-config-api-key
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_USE_EMULATORS=false
# Direct Cloud Run URL avoids Firebase Hosting's 60-second API proxy timeout.
# Leave empty for the local Vite proxy.
VITE_API_ORIGIN=https://api.example.invalid
# Use application-default credentials locally or a Cloud Run service identity.
# Never put service-account keys, access tokens or private recordings in Git.
# Optional browser key for the incident location picker. Restrict websites and APIs.
# Local live development reads this from .env.live.
VITE_GOOGLE_MAPS_API_KEY=your-restricted-maps-browser-key
